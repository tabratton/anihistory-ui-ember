{
  "name": "anihistory-ui-ember",
  "version": "0.0.0",
  "private": true,
  "description": "Small description for anihistory-ui-ember goes here",
  "repository": "",
  "license": "MIT",
  "author": "",
  "exports": {
    "./tests/*": "./tests/*",
    "./*": "./app/*"
  },
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "scripts": {
    "build": "vite build",
    "deploy": "ember deploy production --verbose",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"npm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "concurrently \"npm:lint:css -- --fix\"",
    "lint:fix": "concurrently \"npm:lint:*:fix\" --names \"fix:\" --prefixColors auto && npm run format",
    "lint:format": "prettier . --cache --check",
    "lint:intl": "ember-intl-lint",
    "lint:intl:fix": "ember-intl-lint --fix",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "start": "vite",
    "test": "vite build --mode development && testem ci --port 0"
  },
  "dependencies": {
    "@amcharts/amcharts4": "^4.10.40"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.13",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@ember-intl/lint": "^2.3.5",
    "@ember-intl/vite": "^2.2.3",
    "@ember/optional-features": "^3.0.0",
    "@ember/string": "^4.0.1",
    "@ember/test-helpers": "^5.8.0",
    "@embroider/compat": "^4.1.25",
    "@embroider/config-meta-loader": "^1.0.1",
    "@embroider/core": "^4.6.7",
    "@embroider/legacy-inspector-support": "^0.1.3",
    "@embroider/macros": "^1.21.1",
    "@embroider/router": "^3.0.6",
    "@embroider/vite": "^1.7.13",
    "@eslint/js": "^9.39.5",
    "@fortawesome/ember-fontawesome": "^3.1.1",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@glimmer/component": "^2.2.1",
    "@glimmer/tracking": "^1.1.2",
    "@rollup/plugin-babel": "^7.1.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.5",
    "babel-plugin-ember-template-compilation": "^4.0.1",
    "browserslist": "^4.29.5",
    "concurrently": "^10.0.7",
    "decorator-transforms": "^2.4.0",
    "ember-basic-dropdown": "^9.0.1",
    "ember-cli": "~7.3.0",
    "ember-cli-babel": "^8.3.2",
    "ember-cli-deploy": "^2.0.0",
    "ember-cli-deploy-build": "^3.0.0",
    "ember-cli-deploy-cloudfront": "^7.0.0",
    "ember-cli-deploy-display-revisions": "^3.0.0",
    "ember-cli-deploy-manifest": "^3.0.0",
    "ember-cli-deploy-revision-data": "^4.0.0",
    "ember-cli-deploy-s3": "^5.1.0",
    "ember-cli-deploy-s3-index": "^4.0.4",
    "ember-cli-deploy-smart-compress": "^2.0.0",
    "ember-cli-deprecation-workflow": "^4.0.1",
    "ember-concurrency": "^5.3.0",
    "ember-intl": "^9.3.3",
    "ember-load-initializers": "^3.0.1",
    "ember-modifier": "^4.3.0",
    "ember-page-title": "^9.1.0",
    "ember-power-select": "^9.0.5",
    "ember-qunit": "^9.2.0",
    "ember-resolver": "^13.2.0",
    "ember-source": "~7.3.0",
    "ember-template-lint": "^7.9.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ember": "^13.10.0",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-qunit": "^8.2.6",
    "globals": "^17.14.0",
    "lightningcss": "^1.33.0",
    "node-zopfli-es": "^2.0.6",
    "prettier": "^3.10.1",
    "prettier-plugin-ember-template-tag": "^2.1.8",
    "qunit": "^3.0.0",
    "qunit-dom": "^3.6.0",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "tailwindcss": "^4.3.5",
    "testem": "^3.21.5",
    "vite": "^8.3.0"
